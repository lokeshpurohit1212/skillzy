# ==============================================================================
# SKILLZY 2.0 ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Core Database & Authentication
# ------------------------------------------------------------------------------
# MongoDB Atlas or Local Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/skillswap?retryWrites=true&w=majority

# JWT Secret Key for Session Authentication (minimum 32 random characters recommended)
JWT_SECRET=replace-with-a-secure-random-jwt-secret-key

# Server Port & Runtime Mode
PORT=5000
NODE_ENV=development

# Optional Platform Administrator Credentials
ADMIN_ID=admin@skillzy.com
ADMIN_PASS=ChangeMeAdmin123!

# ==============================================================================
# SKILLZY 2.0 INTEGRATION EXTENSIONS (Optional with Built-in Fallbacks)
# ==============================================================================

# 1. AI Learning Copilot & Roadmap Generator (Google Gemini)
# If omitted, Skillzy automatically engages its deterministic AI fallback engine.
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Real-Time HD Virtual Classrooms (LiveKit Cloud or Self-Hosted)
# If omitted, Skillzy automatically uses its native browser WebRTC classroom mode.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# 3. Payments & Pro Memberships — Multi-Gateway Configuration
# If omitted or test keys used, Skillzy automatically operates in safe verified sandbox test-mode.

# A. Razorpay (Cards, UPI GPay/PhonePe/Paytm, Net Banking, Wallets)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# B. Cashfree Payments (UPI Intent, QR, Cards, Net Banking)
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENV=TEST
CASHFREE_WEBHOOK_SECRET=your_cashfree_webhook_secret

# C. PayU (Cards, Net Banking, UPI Modes)
PAYU_MERCHANT_KEY=your_payu_merchant_key
PAYU_MERCHANT_SALT=your_payu_merchant_salt
PAYU_ENV=TEST

# D. Stripe (Credit / Debit Cards & Global Banking)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Merchant UPI VPA for Direct Intent & Dynamic QR Generation
MERCHANT_UPI_VPA=skillzy@icici

# 4. Rate Limiting & Security (Optional Defaults)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=250
