{
  "name": "skill-swap-platform",
  "version": "1.0.0",
  "description": "A platform for users to exchange skills with each other",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client start",
    "build": "npm --prefix client run build",
    "install-all": "npm install && npm --prefix server install && npm --prefix client install",
    "start": "npm --prefix server start",
    "setup": "node setup.js",
    "test": "npm --prefix server test"
  },
  "keywords": [
    "skill-swap",
    "exchange",
    "learning",
    "community"
  ],
  "author": "Skill Swap Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0"
  }
}
